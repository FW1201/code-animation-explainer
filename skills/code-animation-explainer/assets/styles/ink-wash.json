      "label": 30,
      "small": 26,
      "stat": 160,
      "breath": 140,
      "caption": 42
    },
    "lh_display": 1.3,
    "lh_body": 1.6,
    "ls_display": "0.2em",
    "ls_body": "0.06em"
  },
  "layout": {
    "safe": 120,
