{
  "id": "ink-wash",
  "name": "水墨",
  "temperature": "安靜",
  "positioning": "宣紙上一筆一筆畫出來的寫意水墨：大片留白是空間，一筆是山、是浪、是一個動作",
  "fits": [
    "國文古詩詞",
    "成語與典故意境",
    "書法與漢字",
    "中華文化",
    "季節與自然"
  ],
  "avoid_for": [
    "資料圖表",
    "現代科技工具"
  ],
  "benchmarks": [
    "上海美術電影製片廠《山水情》",
    "《臥虎藏龍》竹林一場的動靜節奏"
  ],
  "rationale": "暖色宣紙底；墨分五色（焦濃重淡清）取代顏色；全片只有一個朱紅，留給印章與故事裡最重要的一件小物。",
  "color": {
    "bg": "#F2ECDE",
    "surface": "#F7F2E7",
    "ink": "#1F1C1A",
    "ink-2": "#5F584F",
    "primary": "#3B3631",
    "accent": "#A8321F",
    "accent-2": "#7F786E",
    "hl": "#E6DCC6"
  },
  "graphic_only": [
    "accent-2"
  ],
  "color_semantics": {
    "ink": "焦墨：書法、最銳利的線",
    "primary": "濃墨：輪廓、近景",
    "accent-2": "淡墨：山體、遠景（只當圖形）",
    "accent": "朱紅：印章與唯一一件小物",
    "hl": "清墨：霧、水"
  },
  "type": {
    "display": {
      "family": "\"Chiron Sung HK\", \"Noto Serif TC\", serif",
      "weight": 700
