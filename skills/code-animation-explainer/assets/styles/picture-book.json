    "openings": [
      "翻開封面",
      "一個角色從畫面邊探出頭",
      "一滴顏料落下暈開"
    ],
    "endings": [
      "角色睡著，月亮升起",
      "闔上書",
      "回到第一頁但多了一樣東西"
