      "fits": [
        "季節變化",
        "情緒轉變",
        "日夜交替"
      ]
    },
    {
      "name": "翻頁",
      "how": "整個畫面像書頁翻過",
      "fits": [
        "故事段落",
        "生命週期",
        "一天的作息"
      ]
    },
    {
      "name": "蠟筆塗出",
      "how": "斜線像蠟筆一樣塗滿形狀",
      "fits": [
        "認識顏色",
        "分類",
        "數數"
      ]
    }
