{
  "id": "picture-book",
  "name": "繪本水彩",
  "temperature": "安靜·暖",
  "positioning": "米色畫紙上的水彩暈染與圓體字，像翻開一本繪本",
  "fits": [
    "國小",
    "生命教育",
    "生活課程",
    "自然觀察",
    "閱讀理解"
  ],
  "avoid_for": [
    "高中以上抽象理論",
    "資料圖表"
  ],
  "benchmarks": [
    "幾米繪本的版面留白",
    "Oliver Jeffers 繪本"
  ],
  "rationale": "畫紙米色帶暖；陶土橘、湖藍、鼠尾草綠是水彩最常見的三色，彩度壓低像顏料在紙上；圓體字降低距離感。",
  "color": {
    "bg": "#FBF5EA",
    "surface": "#FFFFFF",
    "ink": "#3B3028",
    "ink-2": "#76665A",
    "primary": "#D9694C",
    "accent": "#3D7EA6",
    "accent-2": "#5B8F74",
    "hl": "#F2CC8F99"
  },
  "color_semantics": {
    "primary": "主角",
    "accent": "水、天空、冷靜",
    "accent-2": "植物、成長",
    "hl": "蠟筆塗底"
  },
  "type": {
    "display": {
      "family": "\"Huninn\", \"LXGW WenKai TC\", sans-serif",
      "weight": 400
    },
