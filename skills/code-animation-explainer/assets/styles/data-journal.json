{
  "id": "data-journal",
  "name": "資料新聞",
  "temperature": "安靜",
  "positioning": "白底細線、單一強調色，讓資料自己說話，像《紐約時報》與 The Pudding 的圖表報導",
  "fits": [
    "統計",
    "研究方法",
    "社會領域",
    "語料庫與量化研究",
    "自然科實驗數據"
  ],
  "avoid_for": [
    "故事、典故",
    "國小低年級"
  ],
  "benchmarks": [
    "The Pudding",
    "New York Times The Upshot",
    "Our World in Data"
  ],
  "rationale": "背景近白但帶 1–2% 暖色避免實驗室冷感；墨藍是報紙印刷的深藍；全片只有一個強調色（緋紅），只標結論。",
  "color": {
    "bg": "#FAF9F6",
    "surface": "#FFFFFF",
    "ink": "#1A1A1A",
    "ink-2": "#5E5E5E",
    "primary": "#2B4C7E",
    "accent": "#C8384E",
    "accent-2": "#9AA5B1",
    "hl": "#FCE9A9"
  },
  "color_semantics": {
    "primary": "主要資料序列",
    "accent": "唯一結論、要學生記住的那一點",
    "accent-2": "對照組、背景資料（灰化）",
    "hl": "註解底色"
  },
  "type": {
    "display": {
      "family": "\"Newsreader\", \"Noto Serif TC\", serif",
      "weight": 700
    },
    "body": {
      "family": "\"Noto Sans TC\", sans-serif",
      "weight": 400
    },
    "mono": "\"JetBrains Mono\", monospace",
    "hand": "\"LXGW WenKai TC\", serif",
    "google": [
      "Newsreader:opsz,wght@6..72,500;6..72,700",
      "Noto Serif TC:wght@700",
      "Noto Sans TC:wght@400;500;700",
      "JetBrains Mono:wght@500",
      "LXGW WenKai TC"
    ],
    "scale": {
      "h1": 84,
      "h2": 64,
      "h3": 46,
      "body": 36,
      "label": 26,
      "small": 24,
      "stat": 200,
      "breath": 112,
      "caption": 42
    },
    "lh_display": 1.15,
    "lh_body": 1.55,
    "ls_display": "0",
    "ls_body": "0.02em"
  },
  "layout": {
    "safe": 120,
    "caption_zone": 180,
    "radius": 0,
    "stroke": 1,
    "offset": 0,
    "tilt": "0deg",
    "shadow": "none",
    "tex_opacity": 0,
    "ink_width": 3,
    "cap_radius": 0,
    "composition": [
      "左對齊、12 欄網格，圖表占 8 欄、註解占 4 欄",
      "標題直接寫結論（例：「『對』比『跟』多出三倍」）",
      "1px 細線與大量留白"
    ]
  },
  "texture": [],
  "components": [
    "stat",
    "callout",
    "ink",
    "ul"
  ],
  "motion": {
    "ease": {
      "enter": "power3.out",
      "exit": "power2.in",
      "pop": "power3.out",
      "move": "power2.inOut",
      "draw": "power1.inOut"
    },
    "dur": {
      "enter": 0.7,
      "exit": 0.4,
      "pop": 0.5,
      "move": 1.2,
      "draw": 1.2,
      "hold": 0.6
    },
    "stagger": 0.03,
    "idle": "無；靠資料轉換本身的運動，靜止時讓學生讀數字",
    "signature": [
      "同一批資料點在長條→散點→群聚之間平滑轉換",
      "數字從 0 跑到實際值（tabular-nums 防跳動）",
      "對照組淡成灰、結論那條轉成強調色"
    ]
  },
  "camera": {
    "establish": 1.0,
    "max_zoom": 1.3,
    "budget": "15 秒內 ≤2 次；圖表多半不動鏡頭",
    "moves": [
      "推近單一資料點",
      "不做旋轉與傾斜"
    ]
  },
  "transition": {
    "default": "共享元素：資料點直接變形成下一張圖",
    "chapter": "白場＋結論式標題"
  },
  "caption": {
    "bg": "color-mix(in oklab, var(--bg) 92%, transparent)",
    "ink": "var(--ink)",
    "kw": "var(--accent)",
    "world": "圖說：襯線字、左對齊、上方一條細線，像報紙圖表下的說明"
  },
  "sound": {
    "bgm": "極低音量環境音或無",
    "sfx_density": "0–1 個／10 秒",
    "sfx": [
      "結論揭曉的單一輕響"
    ],
    "foley": [
      "鉛筆點下資料點",
      "刻度重設的喀聲"
    ],
    "palette": "低音量環境音、單一鋼琴"
  },
  "do": [
    "每個數字都能對回出處",
    "軸線、刻度、單位寫清楚",
    "沒有原始數值只畫方向並註明"
  ],
  "dont": [
    "3D 圓餅圖",
    "漸層填色",
    "每根長條不同顏色",
    "裝飾性圖示"
  ],
  "board": "split",
  "graphic_only": [
    "accent-2"
  ],
  "essence": [
    "圖表本身就是鏡頭與劇情：資料一筆一筆畫出來",
    "顏色只編碼一件事（數值或類別），其他都是墨色",
    "標題直接寫結論，註解用引線釘在數字旁",
    "沒有原始數值就不畫數值"
  ],
  "not": [
    "不是 ISOTYPE（不是重複圖示，是座標圖表）",
    "不是雜誌編排（安靜、留白、少強調）"
  ],
  "native_moves": [
    {
      "name": "同一批資料換圖",
      "how": "長條→散點→群聚，資料點不消失只變形",
      "fits": [
        "班級成績分布",
        "語料中三個介詞的頻率",
        "各縣市人口"
      ]
    },
    {
      "name": "座標軸長出來",
      "how": "軸線與刻度先長出，資料才落下",
      "fits": [
        "時間序列",
        "前後測比較",
        "氣溫變化"
      ]
    },
    {
      "name": "其他變灰只留一條",
      "how": "對照組淡成灰，結論那條轉成強調色",
      "fits": [
        "實驗組 vs 對照組",
        "一個學生的進步",
        "一種用法的特例"
      ]
    },
    {
      "name": "數字跑到實際值",
      "how": "數字從 0 跑到實際值（tabular-nums）",
      "fits": [
        "百分比",
        "樣本數",
        "成長倍數"
      ]
    }
  ],
  "camera_vocab": [
    {
      "move": "鎖定不動",
      "expresses": "讓學生讀數字",
      "serves": "結論、定義"
    },
    {
      "move": "推近一個資料點",
      "expresses": "這一個很特別",
      "serves": "離群值、個案"
    },
    {
      "move": "拉遠到全圖",
      "expresses": "看出整體趨勢",
      "serves": "統整"
    }
  ],
  "pitfalls": [
    {
      "issue": "拉長色階讓變化看起來更大",
      "fix": "誠實比戲劇重要：淡就是淡"
    },
    {
      "issue": "每根長條不同顏色",
      "fix": "顏色只編碼一件事"
    },
    {
      "issue": "用淡入淡出換圖",
      "fix": "轉場就是圖表操作：變形、重設刻度、拉遠"
    }
  ],
  "variation": {
    "structures": [
      "一個問題、一張圖、一個答案",
      "同一批資料連換三種圖",
      "前測→介入→後測"
    ],
    "openings": [
      "一個空座標軸和一個問句",
      "一個資料點獨自出現",
      "結論標題先出現，資料再來證明"
    ],
    "endings": [
      "只剩結論那一條線",
      "拉遠看完整圖表",
      "留下一個還沒有資料的空欄位"
    ]
  },
  "assets": {
    "icon": {
      "mode": "line",
      "stroke": 1.75,
      "cap": "butt",
      "color": "ink-2",
      "accent": "accent",
      "source": "Lucide／Tabler（線條圖示）"
    },
    "photo": {
      "treatment": "duotone",
      "frame": "none",
      "allowed": true,
      "tones": [
        "ink",
        "bg"
      ]
    },
    "illustration": {
      "recolor": true,
      "max_colors": 3
    },
    "chart": {
      "axis": "ink-2",
      "grid": "hairline",
      "mark": "dot",
      "label": "callout"
    },
    "text": {
      "label": "plain",
      "emphasis": "color",
      "number": "stat",
      "quote": "rule"
    },
    "avoid": [
      "emoji",
      "3D 圖示",
      "彩色漸層插畫"
    ],
    "note": "照片只當背景脈絡，轉成雙色調；圖表格線用 1px 細線"
  }
}
