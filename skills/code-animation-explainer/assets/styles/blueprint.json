      "正交平移（不旋轉、不透視）",
      "推近到某個接合點"
    ]
  },
  "transition": {
    "default": "線稿擦除再重畫",
    "chapter": "整張圖紙往左平移換下一張"
  },
  "caption": {
    "bg": "color-mix(in oklab, var(--bg) 80%, black)",
