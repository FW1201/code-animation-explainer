    "ease": {
      "enter": "power3.out",
      "exit": "power2.in",
      "pop": "power3.out",
      "move": "power2.inOut",
      "draw": "power1.inOut"
    },
    "dur": {
      "enter": 0.5,
      "exit": 0.35,
      "pop": 0.4,
      "move": 1.0,
      "draw": 1.2,
      "hold": 0.5
    },
    "stagger": 0.05,
    "idle": "格線極慢平移；標註箭頭微弱閃爍一次即停",
    "signature": [
      "線稿先描出輪廓再填色",
      "爆炸拆解：構件沿軸線分開、標上名稱、再組回去",
      "尺寸線兩端箭頭同時長出"
    ]
  },
  "camera": {
    "establish": 1.0,
    "max_zoom": 1.8,
    "budget": "15 秒內 ≤3 次",
