    "物理機構",
    "電腦與程式架構",
    "建築與地理"
  ],
  "avoid_for": [
    "情感故事",
    "國小低年級"
  ],
  "benchmarks": [
    "Animagraffs 機構剖析",
    "IKEA 組裝圖（拆解語法）"
  ],
  "rationale": "曬圖藍是傳統藍圖紙的色；白線是線稿；標註黃借自工程圖紅線修改的醒目色但改黃以符合藍底對比。",
  "color": {
    "bg": "#123F6B",
    "surface": "#174B7E",
    "ink": "#EAF4FF",
    "ink-2": "#A6C8EA",
    "primary": "#8FDCFF",
    "accent": "#FFC857",
    "accent-2": "#FF8A65",
    "hl": "#FFC85744"
  },
  "color_semantics": {
    "primary": "主要構件",
