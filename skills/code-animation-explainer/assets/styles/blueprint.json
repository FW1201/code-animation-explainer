    "hl": "標註底色"
  },
  "type": {
    "display": {
      "family": "\"Chiron Hei HK\", \"Noto Sans TC\", sans-serif",
      "weight": 700
    },
    "body": {
      "family": "\"Noto Sans TC\", sans-serif",
      "weight": 400
    },
    "mono": "\"JetBrains Mono\", monospace",
