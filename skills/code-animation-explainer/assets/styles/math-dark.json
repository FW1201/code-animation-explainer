  ],
  "camera_vocab": [
    {
      "move": "推近到某一項",
      "expresses": "就是這一項在變",
      "serves": "代換、關鍵步驟"
    },
    {
      "move": "平移座標平面",
      "expresses": "看別的區域",
      "serves": "函數行為"
    },
    {
      "move": "拉遠看整個推導",
      "expresses": "從頭到尾",
      "serves": "統整"
    }
