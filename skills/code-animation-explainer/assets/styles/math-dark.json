  "native_moves": [
    {
      "name": "符號飛到圖形上",
      "how": "式子裡的 x 飛到座標軸上對應位置",
      "fits": [
        "一次函數",
        "畢氏定理",
        "面積公式"
      ]
    },
    {
      "name": "代換",
      "how": "舊項淡出、新項從同位置長出",
      "fits": [
        "解方程式",
        "化簡",
        "微分"
      ]
    },
    {
      "name": "曲線描出",
      "how": "函數圖形由左到右描出",
      "fits": [
        "二次函數",
        "正弦波",
        "成長曲線"
      ]
