  },
  "texture": [],
  "components": [
    "ink",
    "hl",
    "t-mono"
  ],
  "motion": {
    "ease": {
      "enter": "power2.out",
      "exit": "power2.in",
      "pop": "power2.out",
      "move": "power2.inOut",
      "draw": "power1.inOut"
    },
    "dur": {
      "enter": 0.8,
      "exit": 0.5,
      "pop": 0.5,
      "move": 1.2,
      "draw": 1.4,
      "hold": 0.8
    },
    "stagger": 0.05,
    "idle": "目前的式子輕微亮度呼吸；其他元素暗到 40%",
    "signature": [
      "式子裡的符號飛到圖形上對應的位置（共享元素）",
      "曲線從左描到右",
      "代換時舊項淡出、新項從同位置長出"
    ]
  },
  "camera": {
    "establish": 1.0,
    "max_zoom": 1.6,
    "budget": "15 秒內 ≤2 次",
    "moves": [
      "推近到某一項",
      "平移座標平面"
    ]
  },
  "transition": {
    "default": "形變（舊式子變成新式子）",
    "chapter": "全畫面淡到背景色再浮出新標題"
