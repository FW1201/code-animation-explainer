{
  "id": "math-dark",
  "name": "深底數學（3Blue1Brown 式）",
  "temperature": "大膽·冷靜",
  "positioning": "深色畫布上，顏色就是變數，公式和圖形互相變形",
  "fits": [
    "數學",
    "物理公式",
    "幾何證明",
    "函數與圖形",
    "演算法"
  ],
  "avoid_for": [
    "國小低年級",
    "人文故事"
  ],
  "benchmarks": [
    "3Blue1Brown（Manim）",
    "Eddie Woo 數學視覺化"
  ],
  "rationale": "背景用帶暖的炭黑而不是 GitHub 深藍；藍、黃、綠三色各綁一個變數且全片不換，觀眾靠顏色追蹤變數。",
  "color": {
    "bg": "#1C1D21",
    "surface": "#26282E",
    "ink": "#ECECEC",
    "ink-2": "#9A9DA6",
    "primary": "#58C4DD",
    "accent": "#F2D45C",
    "accent-2": "#83C167",
    "hl": "#58C4DD40"
  },
  "color_semantics": {
    "primary": "變數 x／第一個量",
    "accent": "變數 y／結果",
    "accent-2": "常數或第三個量",
    "hl": "目前在講的那一項"
  },
  "type": {
    "display": {
      "family": "\"Noto Serif TC\", serif",
      "weight": 600
    },
    "body": {
      "family": "\"Noto Sans TC\", sans-serif",
      "weight": 400
    },
    "mono": "\"JetBrains Mono\", monospace",
    "hand": "\"Noto Serif TC\", serif",
    "google": [
      "Noto Serif TC:wght@600;900",
      "Noto Sans TC:wght@400;700",
      "JetBrains Mono:wght@500"
    ],
    "scale": {
      "h1": 88,
      "h2": 68,
      "h3": 50,
      "body": 40,
      "label": 28,
      "small": 24,
      "stat": 180,
      "breath": 120,
      "caption": 44
    },
    "lh_display": 1.2,
    "lh_body": 1.5,
