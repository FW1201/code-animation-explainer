{
  "id": "puppet-shadow",
  "name": "剪紙皮影",
  "temperature": "大膽·暖",
  "positioning": "木框裡的背光幕布，彩色半透明的皮影人物用關節演故事",
  "fits": [
    "歷史",
    "典故",
    "成語故事",
    "民俗節慶",
    "古文情境"
  ],
  "avoid_for": [
    "數據",
    "現代科技工具"
  ],
  "benchmarks": [
    "臺灣皮影戲（高雄皮影戲館）",
    "Lotte Reiniger《阿基米德王子歷險記》剪影動畫"
  ],
  "rationale": "幕布暖黃模擬油燈透光，木框深褐；人物用朱紅、青綠這兩個傳統戲服色，彩度壓低像透光的牛皮。詳見 puppet-style.md。",
  "color": {
    "bg": "#3A2418",
    "surface": "#F3C677",
    "ink": "#2A1A12",
    "ink-2": "#6E4B33",
    "primary": "#B5332E",
    "accent": "#2F6E5E",
    "accent-2": "#D98E04",
    "hl": "#F3C67788",
    "kicker-ink": "var(--accent-2)"
  },
  "color_semantics": {
    "primary": "主角戲服",
    "accent": "配角戲服",
    "accent-2": "道具、燈火",
    "hl": "燈光"
  },
  "type": {
    "display": {
      "family": "\"Chiron Sung HK\", \"Noto Serif TC\", serif",
      "weight": 900
    },
    "body": {
      "family": "\"LXGW WenKai TC\", serif",
      "weight": 400
    },
    "mono": "\"JetBrains Mono\", monospace",
    "hand": "\"LXGW WenKai TC\", serif",
    "google": [
      "Chiron Sung HK:wght@700;900",
      "Noto Serif TC:wght@900",
      "LXGW WenKai TC:wght@400;700"
    ],
    "scale": {
      "h1": 100,
      "h2": 76,
      "h3": 54,
      "body": 42,
      "label": 30,
      "small": 26,
      "stat": 160,
      "breath": 132,
      "caption": 46
    },
    "lh_display": 1.2,
    "lh_body": 1.5,
    "ls_display": "0.08em",
    "ls_body": "0.04em"
  },
  "layout": {
    "safe": 120,
    "caption_zone": 200,
    "radius": 0,
    "stroke": 4,
    "offset": 0,
    "tilt": "0deg",
    "shadow": "none",
    "tex_opacity": 0.4,
    "ink_width": 5,
    "cap_radius": 0,
    "composition": [
      "人物站在幕布下緣的地面線上（65–80% 高）",
      "對話的兩人面對面，左右各占 30%",
      "字幕放在木框下緣，像戲台字幕"
